#
# https://help.github.com/articles/dealing-with-line-endings/
#
# Linux start script should use lf
/gradlew        text eol=lf

# Keep source and build configuration consistent across platforms
*.java          text eol=lf
*.kt            text eol=lf
*.kts           text eol=lf

# These are Windows script files and should use crlf
*.bat           text eol=crlf

